<?xml version="1.0" encoding="utf-8"?>
<base:SettingsBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:CalculatorApp.SettingsPage.Base"
    xmlns:backup="clr-namespace:CalculatorApp.SettingsPage.Backup"
    xmlns:fonts="clr-namespace:CalculatorApp.Resources.Fonts"
    x:Class="CalculatorApp.SettingsPage.Backup.BackupSettingsPage"
    x:DataType="backup:BackupSettings" Header="Backup">
    <base:SettingsBasePage.SettingsContent>
        <VerticalStackLayout>
            <backup:BackupOptions
                CornerRadius="15, 15, 5, 5"
                Name="Backup items"
                Description="This items will be included in the backup"
                Icon="{x:Static fonts:MaterialSymbols.SaveOptions}"
                IncludePreferences="{Binding BackupPreferences}"
                IncludeHistory="{Binding BackupHistory}"
                IncludeCustomModel="{Binding BackupCustomModel}"/>
            <backup:BackupSetting
                CornerRadius="5, 5, 5, 5"
                Name="Import backup"
                Description="Get app data back into it"
                Icon="{x:Static fonts:MaterialSymbols.Import}"
                Command="{Binding ImportCommand}"/>
            <backup:BackupSetting
                CornerRadius="5, 5, 15, 15"
                Name="Export backup"
                Description="Save a copy of app's data"
                Icon="{x:Static fonts:MaterialSymbols.Export}"
                Command="{Binding ExportCommand}"/>
        </VerticalStackLayout>
    </base:SettingsBasePage.SettingsContent>
</base:SettingsBasePage>
