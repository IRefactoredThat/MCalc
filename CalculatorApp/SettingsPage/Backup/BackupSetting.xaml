<?xml version="1.0" encoding="utf-8"?>

<contentButton:ContentButton xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:contentButton="clr-namespace:CalculatorApp.SharedElements.ContentButton"
                     x:Class="CalculatorApp.SettingsPage.Backup.BackupSetting"
                     x:Name="Root">
    <Grid RowDefinitions="Auto, Auto, Auto"
          ColumnDefinitions="Auto, *, Auto"
          Padding="0, 10, 0, 10">
        <Label
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Style="{StaticResource SettingsIcon}"
            Text="{Binding Source={x:Reference Root}, Path=Icon}" />
        <Label
            Grid.Row="0"
            Grid.Column="1"
            Style="{StaticResource SettingName}"
            Text="{Binding Source={x:Reference Root}, Path=Name}" />
        <Label
            Grid.Row="1"
            Grid.Column="1"
            Style="{StaticResource SettingDescription}"
            Text="{Binding Source={x:Reference Root}, Path=Description}" />
    </Grid>
</contentButton:ContentButton>
