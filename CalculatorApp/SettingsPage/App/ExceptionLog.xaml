<?xml version="1.0" encoding="utf-8"?>
<contentButton:ContentButton
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:CalculatorApp.SettingsPage.App"
    xmlns:fonts="clr-namespace:CalculatorApp.Resources.Fonts"
    xmlns:contentButton="clr-namespace:CalculatorApp.SharedElements.ContentButton"
    x:Class="CalculatorApp.SettingsPage.App.ExceptionLog"
    x:Name="Root"
    x:DataType="app:AppSettings"
    Style="{StaticResource ExceptionLogHeader}"
    Clicked="OnClicked">
    <Grid ColumnDefinitions="Auto, *, Auto"
          RowDefinitions="Auto, Auto"
          Padding="0, 10, 0, 10">
        <Label
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Style="{StaticResource SettingsIcon}"
            Text="{x:Static fonts:MaterialSymbols.Bug}"/>
        <Label
            Grid.Row="0"
            Grid.Column="1"
            Style="{StaticResource SettingName}"
            Text="Exception log"/>
        <Label
            Grid.Row="1"
            Grid.Column="1"
            Style="{StaticResource SettingDescription}"
            Text="Click to view logs"/>
        <Label
            Margin="0, 0, 10, 0"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="2"
            Style="{StaticResource SettingsIcon}"
            Text="{x:Static fonts:MaterialSymbols.GoToPage}"/>
    </Grid>
</contentButton:ContentButton>
