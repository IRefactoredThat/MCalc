<?xml version="1.0" encoding="utf-8"?>
<Grid
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:app="clr-namespace:CalculatorApp.SettingsPage.App"
    xmlns:fonts="clr-namespace:CalculatorApp.Resources.Fonts"
    xmlns:contentButton="clr-namespace:CalculatorApp.SharedElements.ContentButton"
    x:Class="CalculatorApp.SettingsPage.App.ExceptionLog"
    x:DataType="app:AppSettings"
    RowDefinitions="Auto, *">
    <contentButton:ContentButton
        Grid.Row="0"
        Style="{StaticResource ExceptionLogHeader}"
        Command="{Binding CopyErrorsCommand}">
        <Grid ColumnDefinitions="Auto, *, Auto"
              RowDefinitions="Auto, Auto"
              Padding="0, 10, 0, 10">
            <Label
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Style="{StaticResource SettingsIcon}"
                Text="{x:Static fonts:MaterialSymbols.Bug}"/>
            <Label
                Grid.Row="0"
                Grid.Column="1"
                Style="{StaticResource SettingName}"
                Text="Exception log"/>
            <Label
                Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource SettingDescription}"
                Text="Click to copy logs"/>
            <Label
                Margin="0, 0, 10, 0"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="2"
                Style="{StaticResource SettingsIcon}"
                Text="{x:Static fonts:MaterialSymbols.Copy}"/>
        </Grid>
    </contentButton:ContentButton>
    <contentButton:ContentButton Grid.Row="1" Style="{StaticResource ExceptionLogBody}">
        <CollectionView VerticalScrollBarVisibility="Never"
            ItemsSource="{Binding Exceptions}"
            ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.EmptyView>
                <Label
                    Margin="0, 24, 0, 24"
                    Text="No exceptions were thrown"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="app:CapturedException">
                    <contentButton:ContentButton Style="{StaticResource ExceptionLogEntry}">
                        <Grid
                            Padding="10, 8"
                            RowDefinitions="Auto, Auto, Auto"
                            ColumnDefinitions="Auto, *"
                            ColumnSpacing="10"
                            RowSpacing="4">
                            <Label
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Grid.Column="0"
                                Style="{StaticResource ErrorTintedIcon}"
                                Text="{x:Static fonts:MaterialSymbols.Error}"
                                VerticalOptions="Start"/>
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Style="{StaticResource ExceptionLogTime}"
                                Text="{Binding Time, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}"/>
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource ErrorText}"
                                LineBreakMode="WordWrap"
                                MaxLines="3"
                                Text="{Binding Message}"/>
                            <Label
                                Grid.Row="2"
                                Grid.Column="1"
                                Style="{StaticResource ExceptionLogStack}"
                                MaxLines="3"
                                Text="{Binding StackTrace}"/>
                        </Grid>
                    </contentButton:ContentButton>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
            </CollectionView.ItemsLayout>
        </CollectionView>
    </contentButton:ContentButton>
</Grid>
