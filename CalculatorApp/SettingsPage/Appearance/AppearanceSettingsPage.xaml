<?xml version="1.0" encoding="utf-8"?>
<base:SettingsBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:CalculatorApp.SettingsPage.Base"
    xmlns:fonts="clr-namespace:CalculatorApp.Resources.Fonts"
    xmlns:appearance="clr-namespace:CalculatorApp.SettingsPage.Appearance"
    xmlns:pageNavigation="clr-namespace:CalculatorApp.SettingsPage.Types.PageNavigation"
    xmlns:colors="clr-namespace:CalculatorApp.SettingsPage.Colors"
    xmlns:expandable="clr-namespace:CalculatorApp.SettingsPage.Types.Expandable"
    xmlns:toggle="clr-namespace:CalculatorApp.SettingsPage.Types.Toggle"
    xmlns:stepSlider="clr-namespace:CalculatorApp.SettingsPage.Types.StepSlider"
    x:Class="CalculatorApp.SettingsPage.Appearance.AppearanceSettingsPage"
    x:DataType="appearance:AppearanceSettings"
    Header="Appearance">
    <base:SettingsBasePage.SettingsContent>
        <VerticalStackLayout>
            <expandable:ExpandableOptionsSetting
                CornerRadius="15, 15, 5, 5"
                Name="Theme mode"
                Description="Choose how the app looks"
                Icon="{x:Static fonts:MaterialSymbols.Paint}"
                ExpandableValues="{Binding AmoledValues}"
                ExpandableView="{x:Reference AmoledSetting}"
                SelectedOption="{Binding PreferredTheme}"/>
            <toggle:ToggleSetting
                x:Name="AmoledSetting"
                CornerRadius="5, 5, 5, 5"
                Name="Darker theme"
                Description="Apply darker tone to colors"
                Icon="{x:Static fonts:MaterialSymbols.Amoled}"
                IsToggled="{Binding AmoledEnabled}"/>
            <expandable:ExpandableOptionsSetting
                CornerRadius="5, 5, 5, 5"
                Name="Color source"
                Description="Derive colors or choose each one manually"
                Icon="{x:Static fonts:MaterialSymbols.CustomColors}"
                ExpandableValues="{x:Static appearance:AppearanceSettings.ManualColorModes}"
                ExpandableView="{x:Reference ManualColors}"
                NonExpandableView="{x:Reference DerivedColors}"
                SelectedOption="{Binding ColorMode}"/>
            <pageNavigation:PageNavigationSetting
                x:Name="DerivedColors"
                CornerRadius="5, 5, 5, 5"
                Name="Seed color"
                Description="Choose single-color source"
                Icon="{x:Static fonts:MaterialSymbols.SeedSource}"
                Route="{x:Type colors:ColorSettingsPage}"/>
            <pageNavigation:PageNavigationSetting
                x:Name="ManualColors"
                CornerRadius="5, 5, 15, 15"
                Name="Custom palette"
                Description="Choose each color separately"
                Icon="{x:Static fonts:MaterialSymbols.ManualSource}"
                Route="{x:Type colors:ColorRoleSettingsPage}"/>
        </VerticalStackLayout>
    </base:SettingsBasePage.SettingsContent>
</base:SettingsBasePage>
