<?xml version="1.0" encoding="utf-8"?>
<base:SettingsBasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:CalculatorApp.SettingsPage.Base"
    xmlns:fonts="clr-namespace:CalculatorApp.Resources.Fonts"
    xmlns:appearance="clr-namespace:CalculatorApp.SettingsPage.Appearance"
    xmlns:colors="clr-namespace:CalculatorApp.SettingsPage.Colors"
    xmlns:colorWheelSetting="clr-namespace:CalculatorApp.SettingsPage.Colors.ColorWheelSetting"
    xmlns:options="clr-namespace:CalculatorApp.SettingsPage.Types.Options"
    x:Class="CalculatorApp.SettingsPage.Colors.ColorRoleSettingsPage"
    x:Name="ColorRoot"
    x:DataType="colors:ColorRoleSettingsPage">
    <base:SettingsBasePage.SettingsContent>
        <VerticalStackLayout>
            <options:OptionsSetting
                CornerRadius="15, 15, 5, 5"
                Name="Preset"
                Description="Apply a ready-made theme palette"
                Icon="{x:Static fonts:MaterialSymbols.ColorStyle}"
                SelectedOption="{Binding Source={x:Reference ColorRoot}, Path=Preset}"/>
            <VerticalStackLayout
                BindableLayout.ItemsSource="{Binding Source={x:Reference ColorRoot}, Path=ColorRoles}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="appearance:ColorRole">
                        <colorWheelSetting:ColorWheelSetting
                            Name="{Binding Name}"
                            Description="{Binding Description}"
                            Icon="{x:Static fonts:MaterialSymbols.ManualColor}"
                            CornerRadius="{Binding Corners}"
                            Color="{Binding Color}"
                            ClickAnimation="{Binding Source={x:Reference ColorRoot},
                        Path=AnimationSettings.SettingsClickAnimation,
                        x:DataType='base:SettingsBasePage'}"
                            ColorWheelDialog="{Binding Source={x:Reference ColorRoot},
                        Path=ColorWheelDialog,
                        x:DataType='colors:ColorRoleSettingsPage'}"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </base:SettingsBasePage.SettingsContent>
</base:SettingsBasePage>
