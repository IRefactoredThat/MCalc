<?xml version="1.0" encoding="utf-8"?>
<contentButton:ContentButton
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contentButton="clr-namespace:CalculatorApp.SharedElements.ContentButton"
    xmlns:numberPreview="clr-namespace:CalculatorApp.SettingsPage.Formatting"
    x:Class="CalculatorApp.SettingsPage.Formatting.NumberPreview"
    x:Name="Root"
    x:DataType="numberPreview:NumberPreview">
    <Grid RowDefinitions="Auto, *">
        <IndicatorView
            x:Name="IndicatorView"
            Grid.Row="0"
            HorizontalOptions="End"
            VerticalOptions="Start"/>
        <CarouselView
            Grid.Row="1"
            ItemsSource="{Binding Source={x:Reference Root}, Path=Previews}"
            HorizontalScrollBarVisibility="Never"
            VerticalScrollBarVisibility="Never"
            IndicatorView="{x:Reference IndicatorView}">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="numberPreview:Preview">
                    <Label
                        Padding="10"
                        Text="{Binding Text}"
                        FontSize="{DynamicResource NumberPreviewSize}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"/>
                </DataTemplate>
            </CarouselView.ItemTemplate>
            <CarouselView.ItemsLayout>
                <LinearItemsLayout
                    Orientation="Horizontal"
                    SnapPointsAlignment="Center"
                    SnapPointsType="MandatorySingle"/>
            </CarouselView.ItemsLayout>
        </CarouselView>
    </Grid>
</contentButton:ContentButton>
