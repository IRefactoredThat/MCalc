<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:input="clr-namespace:CalculatorApp.CalculatorPage.Input"
    x:Class="CalculatorApp.CalculatorPage.Input.CalculatorInputField"
    Orientation="Horizontal"
    HorizontalScrollBarVisibility="Never"
    x:DataType="input:CalculatorInputViewModel">
    <input:CalculatorInput
        x:Name="Entry"
        Text="{Binding Text, Mode=TwoWay}"
        CursorPosition="{Binding Position, Mode=TwoWay}"
        NormalizePosition="{Binding NormalizePosition}"/>
</ScrollView>
