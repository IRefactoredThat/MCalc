<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CalculatorApp.AppShell"
    x:DataType="Shell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CalculatorApp.UIComponents"
    Shell.FlyoutBehavior="Flyout"
    Title="CalculatorApp">
    <ShellContent
            Title="Calculator"
            Icon="calculator.png"
            ContentTemplate="{DataTemplate local:CalculatorGrid}"
            Route="CalculatorGrid" />
    <ShellContent
            Title="History"
            Icon="history.png"
            ContentTemplate="{DataTemplate local:History}"
            Route="History" />
</Shell>