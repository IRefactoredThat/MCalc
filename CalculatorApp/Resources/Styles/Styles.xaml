<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:typography="clr-namespace:CalculatorApp.SettingsPage.Typography"
    xmlns:input="clr-namespace:CalculatorApp.CalculatorPage.Input"
    xmlns:output="clr-namespace:CalculatorApp.CalculatorPage.Output"
    xmlns:shell="clr-namespace:CalculatorApp.Shell"
    xmlns:openExternalApp="clr-namespace:CalculatorApp.SettingsPage.Types.OpenExternalApp"
    xmlns:options="clr-namespace:CalculatorApp.SettingsPage.Types.Options"
    xmlns:pageNavigation="clr-namespace:CalculatorApp.SettingsPage.Types.PageNavigation"
    xmlns:stepSlider="clr-namespace:CalculatorApp.SettingsPage.Types.StepSlider"
    xmlns:page="clr-namespace:CalculatorApp.CalculatorPage.Page"
    xmlns:toggle="clr-namespace:CalculatorApp.SettingsPage.Types.Toggle"
    xmlns:display="clr-namespace:CalculatorApp.CalculatorPage.MainGrid.Display"
    xmlns:colorChooser="clr-namespace:CalculatorApp.SettingsPage.Colors.ColorChooser"
    xmlns:layoutBuilder="clr-namespace:CalculatorApp.SettingsPage.CustomLayout.LayoutBuilder"
    xmlns:contentButton="clr-namespace:CalculatorApp.SharedElements.ContentButton"
    xmlns:bottomSheet="clr-namespace:CalculatorApp.SharedElements.BottomSheet"
    xmlns:formatting="clr-namespace:CalculatorApp.SettingsPage.Formatting"
    xmlns:buttons="clr-namespace:CalculatorApp.CalculatorPage.Buttons">
    <Style x:Key="PrimaryPreset" TargetType="buttons:CalculatorButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
    </Style>
    <Style x:Key="SecondaryPreset" TargetType="buttons:CalculatorButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}"/>
    </Style>
    <Style x:Key="SurfaceBackPreset" TargetType="buttons:CalculatorButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerLow}"/>
    </Style>
    <Style x:Key="SurfaceFrontPreset" TargetType="buttons:CalculatorButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainer}"/>
    </Style>
    <Style TargetType="display:CalculatorLayout" ApplyToDerivedTypes="True">
        <Setter Property="SafeAreaEdges" Value="Container"/>
    </Style>
    <Style x:Key="CalculatorButtonLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Icon" TargetType="Label">
        <Setter Property="FontFamily" Value="{x:Static typography:TypographySettings.Icons}"/>
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}"/>
        <Setter Property="FontSize" Value="{DynamicResource IconSize}"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingsIcon" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="Padding" Value="12, 0"/>
    </Style>
    <Style x:Key="Toolbar" TargetType="HorizontalStackLayout">
        <Setter Property="HorizontalOptions" Value="End"/>
        <Setter Property="HeightRequest" Value="40"/>
        <Setter Property="Margin" Value="0, 0, 4, 0"/>
    </Style>
    <Style x:Key="ToolbarIcon" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}"/>
    </Style>
    <Style x:Key="PrimaryIcon" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
    </Style>
    <Style x:Key="TertiaryIcon" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="TextColor" Value="{DynamicResource OnTertiary}"/>
    </Style>
    <Style x:Key="ErrorIcon" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="TextColor" Value="{DynamicResource OnError}"/>
    </Style>
    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Error}"/>
    </Style>
    <Style x:Key="ErrorButton" TargetType="contentButton:ContentButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource Error}"/>
        <Setter Property="Padding" Value="12, 6"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="contentButton:ContentButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="TertiaryButton" TargetType="contentButton:ContentButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource Tertiary}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="ToolbarButton" TargetType="contentButton:ContentButton">
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Margin" Value="0, 4, 4, 0"/>
        <Setter Property="Padding" Value="8, 0, 8, 0"/>
    </Style>
    <Style TargetType="Label" ApplyToDerivedTypes="True">
        <Setter Property="TextColor" Value="{DynamicResource OnBackground}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
    </Style>
    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}"/>
        <Setter Property="PlaceholderColor" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}"/>
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
    </Style>
    <Style TargetType="SearchHandler">
        <Setter Property="TextColor" Value="{DynamicResource OnSurface}"/>
        <Setter Property="PlaceholderColor" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}"/>
        <Setter Property="FontSize" Value="{DynamicResource DefaultFontSize}"/>
    </Style>
    <Style TargetType="Slider" ApplyToDerivedTypes="True">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource Primary}"/>
        <Setter Property="MaximumTrackColor" Value="{DynamicResource SurfaceVariant}"/>
        <Setter Property="ThumbColor" Value="{DynamicResource Primary}"/>
    </Style>
    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource Primary}"/>
        <Setter Property="OffColor" Value="{DynamicResource SurfaceContainerHighest}"/>
        <Setter Property="ThumbColor" Value="{DynamicResource Outline}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <Setter.Value>
                <VisualStateGroupList>
                    <VisualStateGroup Name="CheckStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter
                                    Property="ThumbColor"
                                    Value="{DynamicResource Outline}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Checked">
                            <VisualState.Setters>
                                <Setter
                                    Property="ThumbColor"
                                    Value="{DynamicResource OnPrimary}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="IndicatorView">
        <Setter Property="SelectedIndicatorColor" Value="{DynamicResource Primary}"/>
        <Setter Property="IndicatorColor" Value="{DynamicResource Outline}"/>
        <Setter Property="IndicatorSize" Value="8"/>
        <Setter Property="Margin" Value="10"/>
    </Style>
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}"/>
    </Style>
    <Style TargetType="shell:AppShell">
        <Setter Property="FlyoutBackground" Value="{DynamicResource Surface}"/>
        <Setter Property="FlyoutBehavior" Value="Flyout"/>
    </Style>
    <Style TargetType="shell:ShellItem">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <Setter.Value>
                <VisualStateGroupList>
                    <VisualStateGroup Name="CheckStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter
                                    Property="BackgroundColor"
                                    Value="{DynamicResource Surface}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Checked">
                            <VisualState.Setters>
                                <Setter
                                    Property="BackgroundColor"
                                    Value="{DynamicResource SurfaceVariant}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ShellItemIcon" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <Setter.Value>
                <VisualStateGroupList>
                    <VisualStateGroup Name="CheckStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{DynamicResource OnSurface}"/>
                                <Setter
                                    Property="FontFamily"
                                    Value="{x:Static typography:TypographySettings.Icons}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Checked">
                            <VisualState.Setters>
                                <Setter
                                    Property="TextColor"
                                    Value="{DynamicResource OnSurfaceVariant}"/>
                                <Setter
                                    Property="FontFamily"
                                    Value="{x:Static typography:TypographySettings.IconsFilled}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ShellItemLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource FlyoutItemSize}"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ShellHeaderLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource FlyoutHeaderSize}"/>
        <Setter Property="TextColor" Value="{DynamicResource OnBackground}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10"/>
    </Style>
    <Style TargetType="input:CalculatorInput">
        <Setter Property="CursorColor" Value="{DynamicResource Outline}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource InputSize}"/>
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="IsSpellCheckEnabled" Value="False"/>
        <Setter Property="HorizontalTextAlignment" Value="End"/>
        <Setter Property="VerticalOptions" Value="End"/>
    </Style>
    <Style TargetType="output:CalculatorOutput">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="{DynamicResource OutputSize}"/>
        <Setter Property="TextColor" Value="{DynamicResource Outline}"/>
        <Setter Property="LineBreakMode" Value="NoWrap"/>
        <Setter Property="HorizontalTextAlignment" Value="End"/>
        <Setter Property="VerticalOptions" Value="End"/>
    </Style>
    <Style TargetType="input:CalculatorInputField">
        <Setter Property="Margin" Value="10, 0, 10, 0"/>
    </Style>
    <Style TargetType="output:CalculatorOutputField">
        <Setter Property="Margin" Value="10, 0, 10, 0"/>
    </Style>
    <Style TargetType="page:InputOutput">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerHighest}"/>
        <Setter Property="CornerRadius" Value="0, 0, 40, 40"/>
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>
    <Style x:Key="Pill" TargetType="BoxView">
        <Setter Property="Margin" Value="0, 20, 0, 10"/>
        <Setter Property="WidthRequest" Value="40"/>
        <Setter Property="HeightRequest" Value="4"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource Outline}"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>
    <Style x:Key="HistoryItem" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource HistoryItemSize}"/>
        <Setter Property="LineBreakMode" Value="NoWrap"/>
        <Setter Property="HorizontalTextAlignment" Value="End"/>
    </Style>
    <Style x:Key="HistoryHeader" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource HistoryHeaderSize}"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="NoHistory" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource HistoryEmptySize}"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>
    <Style TargetType="bottomSheet:BottomSheet">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceDim}"/>
        <Setter Property="CornerRadius" Value="40, 40, 0, 0"/>
    </Style>
    <Style x:Key="ShellTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource ShellTitleSize}"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SettingHeader" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource SettingGroupHeaderSize}"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="Margin" Value="0, 0, 0, 10"/>
    </Style>
    <Style x:Key="SettingSubheader" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource SettingGroupSubheaderSize}"/>
        <Setter Property="Margin" Value="0, 10, 0, 10"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
    </Style>
    <Style x:Key="SettingName" TargetType="Label">
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="FontSize" Value="{DynamicResource SettingNameSize}"/>
    </Style>
    <Style x:Key="SettingDescription" TargetType="Label">
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="FontSize" Value="{DynamicResource SettingDescriptionSize}"/>
    </Style>
    <Style TargetType="toggle:ToggleSetting" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerHigh}"/>
    </Style>
    <Style TargetType="stepSlider:StepSliderSetting" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerHigh}"/>
    </Style>
    <Style TargetType="pageNavigation:PageNavigationSetting" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerHigh}"/>
    </Style>
    <Style TargetType="openExternalApp:OpenExternalAppSetting" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerHigh}"/>
    </Style>
    <Style TargetType="options:OptionsSetting" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerHigh}"/>
    </Style>
    <Style TargetType="colorChooser:ColorChooser" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerHigh}"/>
    </Style>
    <Style TargetType="formatting:NumberPreview" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
    </Style>
    <Style TargetType="layoutBuilder:LayoutBuilder" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerHigh}"/>
    </Style>
    <Style x:Key="LayoutPreview" TargetType="contentButton:ContentButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerHigh}"/>
    </Style>
    <Style x:Key="ExceptionLogHeader" TargetType="contentButton:ContentButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainerHigh}"/>
        <Setter Property="CornerRadius" Value="15, 15, 0, 0"/>
    </Style>
    <Style x:Key="ExceptionLogBody" TargetType="contentButton:ContentButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
        <Setter Property="CornerRadius" Value="0, 0, 5, 5"/>
    </Style>
    <Style x:Key="ExceptionLogEntry" TargetType="contentButton:ContentButton">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceContainer}"/>
        <Setter Property="CornerRadius" Value="10, 10, 10, 10"/>
        <Setter Property="Margin" Value="0, 0, 0, 8"/>
    </Style>
    <Style x:Key="ExceptionLogTime" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="FontSize" Value="{DynamicResource SettingDescriptionSize}"/>
    </Style>
    <Style x:Key="ExceptionLogStack" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="FontSize" Value="{DynamicResource SettingDescriptionSize}"/>
        <Setter Property="LineBreakMode" Value="TailTruncation"/>
    </Style>
    <Style x:Key="ErrorTintedIcon" TargetType="Label" BasedOn="{StaticResource Icon}">
        <Setter Property="TextColor" Value="{DynamicResource Error}"/>
    </Style>
    <Style TargetType="layoutBuilder:SpreadsheetGrid" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
        <Setter Property="BordersColor" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="SelectionBackgroundColor" Value="{DynamicResource Outline}"/>
        <Setter Property="SelectionBordersColor" Value="{DynamicResource OnSurface}"/>
        <Setter Property="PreviewBackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
        <Setter Property="PreviewBordersColor" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="PreviewSelectionBackgroundColor" Value="{DynamicResource Outline}"/>
        <Setter Property="PreviewSelectionBordersColor" Value="{DynamicResource OnSurface}"/>
        <Setter Property="PreviewTextColor" Value="{DynamicResource OnSurface}"/>
        <Setter Property="OccupiedColor1" Value="{DynamicResource PrimaryContainer}"/>
        <Setter Property="OccupiedColor2" Value="{DynamicResource SecondaryContainer}"/>
        <Setter Property="OccupiedColor3" Value="{DynamicResource TertiaryContainer}"/>
        <Setter Property="OccupiedColor4" Value="{DynamicResource InversePrimary}"/>
    </Style>
    <Style
        x:Key="Option"
        TargetType="contentButton:ContentButton">
        <Setter Property="Margin" Value="0, 5, 5, 0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariant}"/>
                            <Setter Property="CornerRadius" Value="20"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}"/>
                            <Setter Property="CornerRadius" Value="10"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style
        x:Key="OptionLabel"
        TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource SettingOptionSize}"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariant}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource OnPrimary}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>
    <Style
        x:Key="ColorPreset"
        x:DataType="colorChooser:ColorPreset"
        TargetType="contentButton:ContentButton">
        <Setter Property="BackgroundColor" Value="{Binding Color}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="WidthRequest" Value="56"/>
        <Setter Property="HeightRequest" Value="56"/>
        <Setter Property="Margin" Value="0, 5, 0, 5"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Style.Triggers>
            <DataTrigger
                TargetType="contentButton:ContentButton"
                Binding="{Binding IsSelected}"
                Value="True">
                <Setter Property="Stroke" Value="{DynamicResource Primary}"/>
                <Setter Property="StrokeThickness" Value="3"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LayoutOption" TargetType="Label">
        <Setter Property="Margin" Value="0, 5, 5, 0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="FontSize" Value="{DynamicResource LayoutOptionSize}"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <Setter.Value>
                <VisualStateGroupList>
                    <VisualStateGroup Name="CheckStates">
                        <VisualState Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.3"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
